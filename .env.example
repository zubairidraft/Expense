# =============================================================================
# Universal Expense Tracker - Environment Configuration Template
# =============================================================================

# Supabase Public API Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# NOTE: NEVER expose SUPABASE_SERVICE_ROLE_KEY to the frontend client.
# Service role key belongs exclusively to backend Edge Functions / CI jobs.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-server-only

# Local Agentation visual feedback endpoint
VITE_AGENTATION_ENDPOINT=http://localhost:4747
